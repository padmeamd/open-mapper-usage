# Project queries

findAllProjects = {
    SELECT id, name, description, created_at FROM projects ORDER BY id
}

findProjectById = {
    SELECT id, name, description, created_at FROM projects WHERE id = [id]
}

findProjectOverview = {
    SELECT p.id, p.name, p.description,
           COUNT(t.id) AS total_tasks,
           COUNT(CASE WHEN t.status = 'DONE' THEN 1 END) AS finished_tasks,
           COUNT(CASE WHEN t.status != 'DONE' THEN 1 END) AS unfinished_tasks,
           (SELECT COUNT(*) FROM project_members pm WHERE pm.project_id = p.id) AS member_count
    FROM projects p
    LEFT JOIN tasks t ON p.id = t.project_id
    WHERE p.id = [id]
    GROUP BY p.id, p.name, p.description
}

findProjectMembers = {
    SELECT u.id, u.first_name, u.last_name, u.email
    FROM users u
    JOIN project_members pm ON u.id = pm.user_id
    WHERE pm.project_id = [project_id]
    ORDER BY u.id
}

createProject = {
    INSERT INTO projects (name, description) VALUES ([name], [description])
}

addProjectMember = {
    INSERT INTO project_members (project_id, user_id, role) VALUES ([project_id], [user_id], [role])
}

removeProjectMember = {
    DELETE FROM project_members WHERE project_id = [project_id] AND user_id = [user_id]
}

deleteProject = {
    DELETE FROM projects WHERE id = [id]
}
